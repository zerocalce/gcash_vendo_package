{
  "name": "gcash-vendo-backend",
  "version": "0.1.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env DB_PATH=:memory: jest --runInBand",
    "test:watch": "cross-env DB_PATH=:memory: jest --watch",
    "docs:sequence:png": "mmdc -i ../docs/sequence.mmd -o ../docs/sequence.png",
    "docs:sequence:svg": "mmdc -i ../docs/sequence.mmd -o ../docs/sequence.svg",
    "docs:wiring:png": "mmdc -i ../docs/wiring.mmd -o ../docs/wiring.png",
    "docs:wiring:svg": "mmdc -i ../docs/wiring.mmd -o ../docs/wiring.svg",
    "docs:build": "npm run docs:sequence:png && npm run docs:sequence:svg && npm run docs:wiring:png && npm run docs:wiring:svg"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@serialport/parser-readline": "^13.0.0",
    "axios": "^1.4.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "pino-http": "^9.0.0",
    "serialport": "^13.0.0",
    "sqlite3": "^5.1.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^10.9.1",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
